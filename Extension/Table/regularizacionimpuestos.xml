<?xml version="1.0" encoding="UTF-8"?>
<!--
    Document   : regularizacionimpuestos
    Description:
        Columnas adicionales para la generación de los ficheros de los modelos 303 y 390 (AEAT).
        Se fusionan con la tabla del core. Almacenan los datos sin origen automático
        en FacturaScripts (tipo de declaración, IBAN y casillas de introducción manual).
-->
<table>
    <column>
        <name>tipodeclaracion</name>
        <type>character varying(1)</type>
    </column>
    <column>
        <name>iban</name>
        <type>character varying(34)</type>
    </column>
    <column>
        <name>sinactividad</name>
        <type>boolean</type>
        <default>false</default>
    </column>
    <column>
        <name>rectificativa</name>
        <type>boolean</type>
        <default>false</default>
    </column>
    <column>
        <name>justificanteant</name>
        <type>character varying(13)</type>
    </column>
    <!-- Casillas de introducción manual (sin origen automático en la contabilidad) -->
    <column>
        <name>c65</name>
        <type>double precision</type>
        <default>100</default>
    </column>
    <column>
        <name>c68</name>
        <type>double precision</type>
        <default>0</default>
    </column>
    <column>
        <name>c70</name>
        <type>double precision</type>
        <default>0</default>
    </column>
    <column>
        <name>c76</name>
        <type>double precision</type>
        <default>0</default>
    </column>
    <column>
        <name>c77</name>
        <type>double precision</type>
        <default>0</default>
    </column>
    <column>
        <name>c78</name>
        <type>double precision</type>
        <default>0</default>
    </column>
    <column>
        <name>c108</name>
        <type>double precision</type>
        <default>0</default>
    </column>
    <column>
        <name>c109</name>
        <type>double precision</type>
        <default>0</default>
    </column>
    <column>
        <name>c110</name>
        <type>double precision</type>
        <default>0</default>
    </column>
    <column>
        <name>c111</name>
        <type>double precision</type>
        <default>0</default>
    </column>
    <column>
        <name>c112</name>
        <type>double precision</type>
        <default>0</default>
    </column>
    <!-- Modelo 390 (regularización anual): datos de identificación del fichero DR390 -->
    <column>
        <name>actividad390</name>
        <type>character varying(40)</type>
    </column>
    <column>
        <name>claveactividad390</name>
        <type>character varying(3)</type>
    </column>
    <column>
        <name>epigrafeiae390</name>
        <type>character varying(4)</type>
    </column>
    <column>
        <name>operaciones347</name>
        <type>boolean</type>
        <default>false</default>
    </column>
    <!-- Modelo 390: casillas de introducción manual (sin origen automático en la contabilidad) -->
    <column>
        <name>c390_96</name>
        <type>double precision</type>
        <default>0</default>
    </column>
    <column>
        <name>c390_106</name>
        <type>double precision</type>
        <default>0</default>
    </column>
    <column>
        <name>c390_107</name>
        <type>double precision</type>
        <default>0</default>
    </column>
    <column>
        <name>c390_112</name>
        <type>double precision</type>
        <default>0</default>
    </column>
    <!-- El asiento de la regularización es uno ya existente que se vinculó a mano (no lo creó el
         plugin): al eliminar la regularización no se elimina el asiento -->
    <column>
        <name>asientomanual</name>
        <type>boolean</type>
        <default>false</default>
    </column>
</table>
